SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
# Para editais, provas e outros arquivos em produção, configure MEDIA_ROOT para um volume persistente.
# MEDIA_ROOT=/var/data/media
# Optional SMTP settings for password reset emails. Without these, Django uses the console backend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Central do Vestibulando <nao-responda@example.com>
